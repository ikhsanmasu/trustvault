# InTrustVault environment variables
# Copy this file to .env.local and fill in your actual values.
# .env.local is gitignored and never committed.

# Supabase project URL (local dev default shown)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon/public key (safe to expose to the browser)
# Copy from supabase start output or Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service-role key (SERVER-ONLY -- never prefix with NEXT_PUBLIC_)
# Copy from supabase start output or Supabase Dashboard > Settings > API
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# DeepSeek API key for AI materiality comparison (SERVER-ONLY)
# Get from https://platform.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key

# --- P5: Blockchain Anchoring (SERVER-ONLY) ---
# Local dev: run `anvil` and use the default values below
# ANCHOR_RPC_URL=http://127.0.0.1:8545
# ANCHOR_CHAIN_ID=31337
# ANCHOR_CONTRACT_ADDRESS=<set after deploy-anchor.ts>
# ANCHOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
#
# Staging: point to Railway Anvil instance or testnet
# ANCHOR_RPC_URL=https://your-anvil.railway.app
# ANCHOR_CHAIN_ID=31337
#
# Production: point to L2 mainnet (Base, Arbitrum, etc.)
# ANCHOR_RPC_URL=https://mainnet.base.org
# ANCHOR_CHAIN_ID=8453
ANCHOR_RPC_URL=http://127.0.0.1:8545
ANCHOR_CHAIN_ID=31337
ANCHOR_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
ANCHOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# OpenAI API key for embeddings (text-embedding-3-small, 1536 dims) (SERVER-ONLY)
# Get from https://platform.openai.com
OPENAI_API_KEY=your-openai-api-key

# --- P16: Agent Channel Encryption (SERVER-ONLY) ---
# 32-byte base64 key for encrypting WhatsApp/Telegram channel credentials at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AGENT_CHANNEL_ENCRYPTION_KEY=your-generated-base64-key

# --- Sentry Error Tracking ---
# Get from https://sentry.io → Settings → Projects → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://o000000.ingest.sentry.io/0000000
SENTRY_DSN=https://o000000.ingest.sentry.io/0000000

# --- Admin Monitoring (SERVER-ONLY, optional but recommended for production) ---
# Set this to a random secret to access /admin/monitoring without tenant auth.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Access: https://your-app.vercel.app/admin/monitoring?secret=<this-value>
ADMIN_MONITORING_SECRET=

# --- P16: Telegram Webhook Security (SERVER-ONLY, optional) ---
# Secret token to verify Telegram webhook requests.
# Set this env var AND pass it as secret_token to setWebhook.
# TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret
